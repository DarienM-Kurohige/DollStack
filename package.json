{
  "name": "integrationsolutions-control-calidad",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto demostrativo de pruebas unitarias y seguridad para AUY1102",
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --ci --coverage --runInBand",
    "security:audit": "npm audit",
    "build": "esbuild src/server.js --bundle --platform=node --target=node22 --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jest": "^30.0.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 100,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
